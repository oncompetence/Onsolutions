<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_payment_coupon_form" model="ir.ui.view">
    <field name="name">account.payment.coupon.form</field>
    <field name="model">account.payment.coupon</field>
    <field name="arch" type="xml">
      <form string="Cupon de Pago">
        <sheet>
          <group>
            <field name="number_card" />
            <field name="expiration_date" />
            <field name="security_code" />
            <field name="card_id" />
            <field name="plan" />
            <field name="amount_coupon" widget="monetary"
              options="{'currency_field': 'currency_id'}" />
            <field name="quantity_coupon" />

            <field name="exchange_rate" widget="monetary"
              options="{'currency_field': 'currency_id'}" />
            <field name="partner_id" />

            <field name="type_document_id" />
            <field name="document" />

            <field name="phone" />

            <field name="coupon_number" />
            <field name="approval_code" />

            <field name="date_coupon" />

            <field name="advance" widget="monetary" options="{'currency_field': 'currency_id'}" />
            <field name="first_due_date" />

            <field name="note" />
            <field name="payment_id" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_account_payment_coupon_list" model="ir.ui.view">
    <field name="name">account.payment.coupon.list</field>
    <field name="model">account.payment.coupon</field>
    <field name="arch" type="xml">
      <list string="Cupones de Pago">
        <field name="payment_id" />
        <field name="number_card" />
        <field name="expiration_date" />
        <field name="card_id" />
        <field name="plan" />
        <field name="amount_coupon" />
        <field name="quantity_coupon" />
        <field name="partner_id" />
        <field name="coupon_number" />
        <field name="approval_code" />
        <field name="date_coupon" />
        <field name="advance" />
        <field name="first_due_date" />
        <field name="note" />
      </list>
    </field>
  </record>

  <record id="action_account_payment_coupon" model="ir.actions.act_window">
    <field name="name">Cupones de Pago</field>
    <field name="res_model">account.payment.coupon</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_payment_coupon_list" />
  </record>

  <menuitem id="menu_account_payment_coupon_list"
    name="Cupones de Pago"
    parent="sale.menu_sale_config"
    sequence="30" />
</odoo>