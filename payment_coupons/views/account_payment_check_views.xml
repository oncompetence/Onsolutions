<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_payment_check_form" model="ir.ui.view">
    <field name="name">account.payment.check.form</field>
    <field name="model">account.payment.check</field>
    <field name="arch" type="xml">
      <form string="Cheque de Pago Diferido">
        <sheet>
          <group>
            <field name="bank_code" />
            <field name="number"/>
            <field name="date"/>
            <field name="payment_date"/>
            <field name="term_days"/>
            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            <field name="endorsable"/>
            <field name="direct"/>
            <field name="electronic"/>
            <field name="num_drawer_document_number" />
            <field name="drawer_document_type"/>
            <field name="drawer_document_number"/>
            <field name="note"/>
            <field name="payment_id" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_account_payment_check_list" model="ir.ui.view">
    <field name="name">account.payment.check.list</field>
    <field name="model">account.payment.check</field>
    <field name="arch" type="xml">
      <list string="Cheques de Pago Diferido">
        <field name="payment_id" />
        <field name="number"/>
        <field name="date"/>
        <field name="payment_date"/>
        <field name="term_days"/>
        <field name="amount"/>
        <field name="note"/>
      </list>
    </field>
  </record>

  <record id="action_account_payment_check" model="ir.actions.act_window">
    <field name="name">Cheques de Pago Diferido</field>
    <field name="res_model">account.payment.check</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_payment_check_list" />
  </record>

  <menuitem id="menu_account_payment_check_list"
    name="Cheques de Pago Diferido"
    parent="sale.menu_sale_config"
    sequence="40" />
</odoo>