<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aquí recreamos la Acción Contextual que tenías en Studio -->
    <record id="action_resolve_not_found_products" model="ir.actions.server">
        <field name="name">traer faltantes</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_resolve_not_found_products()
        </field>
    </record>
</odoo>