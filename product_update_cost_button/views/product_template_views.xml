<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aquí defino la vista heredada para la plantilla del producto -->
    <record id="product_template_form_view_inherit_cost_button" model="ir.ui.view">
        <field name="name">product.template.form.inherit.cost.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Aquí busco el header del formulario para posicionar el botón -->
            <xpath expr="//header" position="inside">
                <button name="%(product_replenishment_cost.action_update_from_replenishment_cost_wizard)d"
                        type="action"
                        string="Actualizar Costo Contable"
                        class="btn-primary"
                        invisible="type == 'service'"/>
            </xpath>
            
        </field>
    </record>
</odoo>