<odoo>
    <template id="report_payslip_add_employee_signature" inherit_id="hr_payroll.report_payslip">
        <xpath expr="//div[@id='to_pay']" position="after">
            <table class="mt-3" style="width: 100%; margin-top: 40px;">
                <tr>
                    <t t-if="o.rrhh_signature">
                        <td style="text-align: center;">
                            <strong>Firma RRHH:</strong><br/>
                            <img t-att-src="'data:image/png;base64,%s' % o.rrhh_signature.decode('utf-8')" style="max-height:100px; margin-top:10px;" />
                        </td>
                    </t>
                    <t t-if="o.employee_signature">
                        <td style="text-align: center;">
                            <strong>Firma Empleado:</strong><br/>
                            <img t-att-src="'data:image/png;base64,%s' % o.employee_signature.decode('utf-8')" style="max-height:100px; margin-top:10px;" />
                        </td>
                    </t>
                </tr>
            </table>
        </xpath>
    </template>
</odoo>