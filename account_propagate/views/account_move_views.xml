<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_move_form_inherit_custom_m2m" model="ir.ui.view">
    <field name="name">account.move.form.inherit.custom.m2m</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
        <xpath expr="//group[@id='header_left_group']" position="inside">
            <field name="custom_tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
            <field name="custom_analytic_line_ids">
                <list editable="bottom">
                    <field name="analytic_id" options="{'no_create': True}"/>
                    <field name="percentage"/>
                </list>
            </field>
        </xpath>
    </field>
  </record>
</odoo>