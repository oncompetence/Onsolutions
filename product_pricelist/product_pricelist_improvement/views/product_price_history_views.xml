<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_product_price_history_tree" model="ir.ui.view">
        <field name="name">view.product.price.history.tree</field>
        <field name="model">product.price.history</field>
        <field name="arch" type="xml">
            <list string="Historial de precios de productos" create="false"
                default_order="update_date desc">
                <field name="update_date" />
                <field name="product_id" />
                <field name="pricelist_id" />
                <field name="previous_price" />
                <field name="current_price" />
                <field name="previous_cost" />
                <field name="current_cost" />
                <field name="user_id" />
                <field name="origin" />
            </list>
        </field>
    </record>

    <record id="action_product_price_history_tree" model="ir.actions.act_window">
        <field name="name">Historial de precios de productos</field>
        <field name="res_model">product.price.history</field>
        <field name="view_mode">list</field>
        <!-- <field name="search_view_id" ref="view_product_price_history_tree" /> -->
    </record>

    <menuitem
        id="menu_account_product_price_history_tree"
        name="Historial de precios"
        action="action_product_price_history_tree"
        parent="account.account_reports_management_menu"
        sequence="25"
    />

</odoo>        